# ============ TalentFlow : copier en .env puis adapter ============
TF_ENV=dev
TF_BRAND_NAME=TalentFlow
TF_API_KEY=change-me
TF_API_BASE_URL=http://localhost:8000
TF_REVIEW_UI_URL=http://localhost:8501

# Base de données : SQLite en local, PostgreSQL + PGVector avec Docker
TF_DATABASE_URL=sqlite:///data/talentflow.db
# TF_DATABASE_URL=postgresql://talentflow:talentflow@postgres:5432/talentflow

# ---- LLM : offline | openai | groq | mistral | ollama | llamacpp | gemini
TF_LLM_PROVIDER=offline
TF_LLM_MODEL=gpt-4o-mini
TF_LLM_API_KEY=
TF_LLM_BASE_URL=
# Modèle local (aucune donnée ne sort) : llama.cpp server (profil docker "local-llm")
# TF_LLM_PROVIDER=llamacpp
# TF_LLM_BASE_URL=http://llamacpp:8080/v1
# TF_LLM_MODEL=qwen2.5-7b-instruct-q4_k_m

# ---- Embeddings : hashing (hors-ligne) | openai | ollama | mistral | sentence-transformers
TF_EMBEDDING_PROVIDER=hashing
TF_EMBEDDING_DIM=512
# TF_EMBEDDING_PROVIDER=openai
# TF_EMBEDDING_MODEL=text-embedding-3-small
# TF_EMBEDDING_DIM=1536

# ---- Matching
TF_RETRIEVAL_K=30
TF_JUDGE_TOP_N=8
TF_PROPOSAL_TOP_K=3
TF_JUDGE_WEIGHT=0.4

# ---- RGPD
TF_USE_PRESIDIO=false
TF_RETENTION_DAYS=730
TF_ANONYMIZE_DOSSIERS=true

# ---- Intégrations
TF_N8N_VALIDATION_WEBHOOK_URL=http://n8n:5678/webhook/talentflow-validation
TF_BOOND_BASE_URL=
TF_BOOND_CLIENT_TOKEN=
TF_BOOND_CLIENT_KEY=
TF_BOOND_USER_TOKEN=
TF_GRAPH_TENANT_ID=
TF_GRAPH_CLIENT_ID=
TF_GRAPH_CLIENT_SECRET=
TF_GRAPH_MAILBOX=

# ---- Adresses utilisées par les workflows n8n (démo : tout arrive dans Mailpit)
TF_MAIL_FROM=talentflow@demo.local
TF_SALES_EMAIL=commercial@demo.local
TF_DIRECTION_EMAIL=direction@demo.local
TF_CLIENT_DEMO_EMAIL=client@demo.local
TF_PROSPECT_DEMO_EMAIL=prospect@demo.local
