        "smtp": {
          "id": "REPLACE_SMTP_ID",
          "name": "SMTP TalentFlow (Mailpit en démo)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TF_API_BASE_URL }}/prospection/{{ $('Emails approuvés').item.json.email_id }}/sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.TF_API_KEY }}"
