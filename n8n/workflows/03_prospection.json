          "id": "REPLACE_SMTP_ID",
          "name": "SMTP TalentFlow (Mailpit en démo)"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "b1443949-3f87-56a5-b287-d51198d7befe",
      "name": "Toutes les heures",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        460
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TF_API_BASE_URL }}/prospection",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.TF_API_KEY }}"
            }
          ]
        },
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "approved"
            }
          ]
        }
      },
      "id": "ff026cb0-e04a-5161-a547-1073a40877ce",
      "name": "Emails approuvés",
