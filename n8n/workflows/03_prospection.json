      "position": [
        240,
        460
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.TF_MAIL_FROM }}",
        "toEmail": "={{ $env.TF_PROSPECT_DEMO_EMAIL }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.body.replace(/\\n/g, '<br>') }}",
        "options": {}
      },
      "id": "54c39eb2-1291-5aa1-a463-d81f193d7839",
      "name": "Envoyer l'email de prospection",
      "type": "n8n-nodes-base.emailSend",
