      "id": "20416f1c-48f6-5808-83bb-c2cb003a0e84",
      "name": "Indicateurs de la semaine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Récapitulatif hebdomadaire pour la direction\nconst weeks = $json.weeks || [];\nconst w = weeks[weeks.length - 1] || {};\nconst pct = v => v == null ? '—' : Math.round(v * 100) + ' %';\nconst line = (k, v) => `<tr><td>${k}</td><td><b>${v ?? '—'}</b></td></tr>`;\nconst top = ($json.pool?.top_skills || []).slice(0, 5).map(s => s[0]).join(', ');\nreturn [{ json: {\n  subject: `[TalentFlow] Bilan de la semaine ${w.week || ''}`,\n  html: `<h3>Bilan TalentFlow – semaine ${w.week || ''}</h3>\n  <table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\">\n  ${line('Besoins clients traités', w.needs_received)}\n  ${line('CV analysés', w.cvs_ingested)}\n  ${line('Profils proposés', w.proposals)}\n  ${line('Profils validés', w.validated)}\n  ${line('Taux de validation', pct(w.validation_rate))}\n  ${line('Délai médian besoin → proposition (min)', w.median_minutes_to_proposal)}\n  ${line('Délai médian de validation (h)', w.median_hours_to_review)}\n  ${line('Temps gagné estimé (h, hypothèse à confirmer)', w.estimated_hours_saved)}\n  </table><p>Vivier : ${$json.pool?.candidates ?? 0} consultants. Compétences les plus présentes : ${top}.</p>`\n}}];"
      },
      "id": "2fe5b61d-e8b4-580e-9afd-9dc0e8517eea",
      "name": "Mettre en forme le bilan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.TF_MAIL_FROM }}",
        "toEmail": "={{ $env.TF_DIRECTION_EMAIL }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "id": "dde13559-c624-50c6-b485-820b1210d845",
      "name": "Envoyer à la direction",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
